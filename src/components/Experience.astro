---
import experience from "../data/experience.json";

const formatDate = (date: string) => {
  if (date === "actual") return "hoy";
  const [year, month] = date.split("-");
  const months = [
    "ene",
    "feb",
    "mar",
    "abr",
    "may",
    "jun",
    "jul",
    "ago",
    "sep",
    "oct",
    "nov",
    "dic",
  ];
  return `${months[parseInt(month) - 1]} ${year}`;
};

// Stable fake commit hash per job, so it doesn't change between builds
const shortHash = (value: string) => {
  let hash = 0;
  for (const char of value) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
  return hash.toString(16).padStart(8, "0").slice(0, 7);
};
---

<section id="experience" class="py-16 border-t border-theme">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="font-mono text-sm text-secondary mb-8">
      <span class="text-accent-green">$</span> git log --career
    </h2>

    <ol class="flex flex-col gap-8 pl-6 border-l-2 border-theme">
      {
        experience.map((job) => {
          const isHead = job.endDate === "actual";
          return (
            <li class="relative font-mono">
              <span
                class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full border-2"
                style={
                  isHead
                    ? "background-color: var(--accent-green); border-color: var(--accent-green)"
                    : "background-color: var(--bg-primary); border-color: var(--accent-blue)"
                }
              />
              <div class="text-sm text-secondary">
                <span class="text-accent-orange">
                  {shortHash(job.company + job.startDate)}
                </span>{" "}
                · {formatDate(job.startDate)} → {formatDate(job.endDate)}
                {isHead && (
                  <span class="text-accent-green border border-theme rounded-full px-2 ml-1.5">
                    HEAD
                  </span>
                )}
              </div>
              <h3 class="text-xl font-bold text-heading mt-1.5">
                {job.company}
              </h3>
              <div class="text-sm text-accent-blue">
                {job.role} · {job.location}
              </div>
              <p class="mt-2 max-w-[70ch] leading-relaxed text-primary">
                {job.description}
              </p>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
