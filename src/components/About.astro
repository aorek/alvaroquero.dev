---
import profile from "../data/profile.json";
import skills from "../data/skills.json";

// Profile rendered as a TypeScript object literal
const fields: [string, string[]][] = [
  ...Object.entries(skills),
  ["hobbies", profile.hobbies],
];
const indent = "  ";
const newline = "\n";
---

<section id="about" class="py-16 border-t border-theme">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="font-mono text-sm text-secondary mb-8">
      <span class="text-accent-green">$</span> cat sobre-mi.ts
    </h2>

    <div class="grid gap-10 md:grid-cols-2 font-mono">
      <p class="max-w-[56ch] leading-relaxed text-primary">{profile.about}</p>

      <pre
        class="text-sm leading-relaxed border border-theme rounded-lg p-5 overflow-x-auto bg-secondary"><span class="text-accent-red">const</span> <span class="text-accent-blue">alvaro</span> = {"{"}
  rol: <span class="text-accent-string">"{profile.title}"</span>,
{fields.map(([key, items]) => (
  <Fragment>{indent}{key}: [{items.map((item, i) => (
    <Fragment><span class="text-accent-string">"{item}"</span>{i < items.length - 1 && ", "}</Fragment>
  ))}],{newline}</Fragment>
))}{"};"}</pre>
    </div>
  </div>
</section>
